{
  "name": "fretdrom",
  "version": "0.4.1",
  "license": "MIT",
  "description": "Chord and scale diagrams for stringed instruments, rendered as SVG",
  "main": "./lib/index.js",
  "bin": {
    "fretdrom": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skins/",
    "dist/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "test": "mocha test",
    "lint": "eslint lib bin skins scripts test eslint.config.js",
    "dist": "esbuild ./lib/fretdrom.js --bundle --format=iife --global-name=FretDrom --outfile=dist/fretdrom.js",
    "dist.min": "esbuild ./lib/fretdrom.js --bundle --format=iife --global-name=FretDrom --minify --outfile=dist/fretdrom.min.js",
    "build": "npm run dist && npm run dist.min",
    "build-editor": "npm run build && cp editor/index.html dist/ && cp -r editor/js dist/",
    "docs": "node scripts/render-fixtures.js docs/images",
    "update-snapshots": "node scripts/render-fixtures.js test/snapshots"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "onml": "^2.1.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.1",
    "mocha": "^11.7.5"
  }
}
